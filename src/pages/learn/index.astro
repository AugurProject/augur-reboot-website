---
import { getCollection } from "astro:content";
import Footer from "../../components/shell/footer.astro";
import PageHeader from "../../components/shell/page-header.tsx";
import PageTitle from "../../components/shell/page-title.astro";
import Layout from "../../layouts/Layout.astro";
import {
	assertLearnEntries,
	getLearnEntryGroup,
	getLearnTopicCatalog,
} from "../../lib/learn";

const learnCollection = await getCollection("learn");
assertLearnEntries(learnCollection);

const topicCards = getLearnTopicCatalog(learnCollection).map((item) => ({
	...item,
	coreEntries: item.availableEntries.filter(
		(entry) => getLearnEntryGroup(entry) === "core",
	),
	caseStudyEntries: item.availableEntries.filter(
		(entry) => getLearnEntryGroup(entry) === "case-study",
	),
	historicalEntries: item.entries.filter(
		(entry) => getLearnEntryGroup(entry) === "historical-record",
	),
}));

const startTopic = topicCards.find(({ topic }) => topic.key === "fork");
if (!startTopic) {
	throw new Error("Learn landing requires the available Fork topic");
}

const orderedTopicCards = [
	startTopic,
	...topicCards.filter(({ topic }) => topic.key !== startTopic.topic.key),
];
---

<Layout
	title="Learn - Augur"
	description="Understand Augur's fork mechanism, dispute system, and historical records."
	ogType="website"
>
	<div class="grid grid-rows-[auto_1fr_auto] min-h-screen">
		<PageHeader client:load backHref="/" />

		<main class="overflow-y-auto px-4 md:px-8 pt-8 mb-12">
			<div class="max-w-3xl mx-auto">
				<PageTitle prefix="LEARN" title="AUGUR" class="mb-8" />

				<p class="text-center leading-tight mb-16 max-w-xl mx-auto">
					Understand how Augur resolves markets, protects its oracle, and responds when
					consensus breaks down.
				</p>

				<div class="border-y border-foreground/20 divide-y divide-foreground/20">
					{orderedTopicCards.map((topic, topicIndex) => (
						<section class="py-10 md:py-12" aria-labelledby={`topic-${topic.topic.key}`}>
							<p class="font-display text-xs tracking-widest text-primary mb-3">
								{topicIndex === 0 ? "START HERE" : "LEARNING PATH"}
							</p>
							<h2
								id={`topic-${topic.topic.key}`}
								class="font-display uppercase text-3xl md:text-4xl text-loud-foreground mb-4"
							>
								{topic.topic.label}
							</h2>
							<p class="leading-snug max-w-2xl mb-8">{topic.topic.description}</p>

							{topic.coreEntries.length > 0 && (
								<ol class="border-t border-foreground/20">
									{topic.coreEntries.map((entry, entryIndex) => (
										<li class="border-b border-foreground/20">
											<a
												href={entry.path}
												class="group flex items-center gap-5 py-5 text-loud-foreground hover:text-primary transition-colors"
											>
												<span class="font-display text-xs tracking-widest text-muted-foreground">
													{String(entryIndex + 1).padStart(2, "0")}
												</span>
												<span class="font-display uppercase tracking-wider flex-1">{entry.label}</span>
												<span aria-hidden="true" class="text-primary group-hover:translate-x-1 transition-transform">
													→
												</span>
											</a>
										</li>
									))}
								</ol>
							)}

							{topic.caseStudyEntries.length > 0 && (
								<div class="mt-10">
									<h3 class="font-display uppercase tracking-widest text-sm text-foreground mb-3">
										Case studies
									</h3>
									<ul class="space-y-2">
										{topic.caseStudyEntries.map((entry) => (
											<li>
												<a href={entry.path} class="text-primary hover:text-loud-foreground transition-colors">
													{entry.label} →
												</a>
											</li>
										))}
									</ul>
								</div>
							)}

							{topic.historicalEntries.length > 0 && (
								<div class="mt-10">
									<h3 class="font-display uppercase tracking-widest text-sm text-muted-foreground mb-3">
										Historical records
									</h3>
									<ul class="space-y-2">
										{topic.historicalEntries.map((entry) => (
											<li>
												<a href={entry.path} class="text-primary hover:text-loud-foreground transition-colors">
													{entry.label} →
												</a>
											</li>
										))}
									</ul>
								</div>
							)}
						</section>
					))}
				</div>
			</div>
		</main>

		<Footer />
	</div>
</Layout>
