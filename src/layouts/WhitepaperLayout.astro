---
import ArticleContent from "../components/content/article-content.astro";
import Footer from "../components/shell/footer.astro";
import PageHeader from "../components/shell/page-header.tsx";
import WhitepaperActions from "../components/whitepaper-actions.tsx";
import Layout from "../layouts/Layout.astro";
import {
	getWhitepaperRoot,
	type WhitepaperEdition,
	type WhitepaperNavigationLink,
} from "../lib/whitepaper";

interface Props {
	edition: WhitepaperEdition;
	title: string;
	breadcrumbTitle?: string;
	rawHref: string;
	isIndex?: boolean;
	previous?: WhitepaperNavigationLink;
	next?: WhitepaperNavigationLink;
}

const { edition, title, breadcrumbTitle = title, rawHref, isIndex = false, previous, next } = Astro.props;
const editionRoot = getWhitepaperRoot(edition);
const publicSiteOrigin = Astro.site?.origin ?? "https://www.augur.net";
const publicMarkdownUrl = new URL(rawHref, publicSiteOrigin).href;
const canonicalURL = new URL(Astro.url.pathname, publicSiteOrigin).href;
const assistantPrompt = [
	`I'm reading the ${edition.shortTitle}, release ${edition.release}.`,
	`Read the Markdown source for "${title}": ${publicMarkdownUrl}`,
	"Help me understand this section while preserving equations and citations, and distinguish the paper's claims from your interpretation.",
].join("\n\n");
const assistantQuery = new URLSearchParams({ q: assistantPrompt }).toString();
const chatGptHref = `https://chatgpt.com/?${assistantQuery}`;
const claudeHref = `https://claude.ai/new?${assistantQuery}`;
---

<Layout
	title={`${title} - ${edition.shortTitle}`}
	description={edition.description}
	ogType="article"
	canonicalURL={canonicalURL}
	alternateLinks={[{
		href: rawHref,
		type: "text/markdown",
		title: `${title} — Markdown`,
	}]}
>
	<div class="grid grid-rows-[auto_1fr_auto] min-h-screen">
		<PageHeader client:load backHref="/" />

		<main class="overflow-y-auto px-4 md:px-8 pt-8 mb-12">
			<div class="max-w-5xl mx-auto pt-8">
				<nav
					aria-label="Whitepaper breadcrumbs"
					class="mb-6 font-display text-xs uppercase tracking-[0.2em] text-muted-foreground"
				>
					<a href="/whitepapers/" class="hover:text-primary transition-colors">
						Whitepapers
					</a>
					<span class="mx-2" aria-hidden="true">/</span>
					<a href={editionRoot} class="hover:text-primary transition-colors">
						{edition.shortTitle}
					</a>
					{!isIndex && (
						<>
							<span class="mx-2" aria-hidden="true">/</span>
							<span aria-current="page" class="text-foreground">{breadcrumbTitle}</span>
						</>
					)}
				</nav>

				<div class="flex flex-wrap items-center justify-between gap-3 border-y border-primary/20 px-4 py-3 mb-2 md:flex-nowrap">
					<div class="min-w-0 font-display text-xs uppercase tracking-[0.2em]">
						<span class="block text-foreground">{edition.shortTitle}</span>
						<span class="mt-1 block text-muted-foreground">
							Release {edition.release} (<code class="normal-case tracking-normal">{edition.sourceRevision}</code>)
						</span>
					</div>
					<div class="flex w-full flex-wrap gap-2 font-display text-xs uppercase tracking-[0.15em] md:w-auto md:shrink-0">
						<WhitepaperActions
							client:load
							markdownHref={rawHref}
							chatGptHref={chatGptHref}
							claudeHref={claudeHref}
						/>
						<a
							href={edition.pdfUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex h-9 items-center gap-2 border border-primary/60 px-3 text-primary transition-colors hover:border-primary hover:bg-primary/10 hover:text-loud-foreground focus:outline-none focus:ring-2 focus:ring-primary/60"
						>
							<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none">
								<path d="M8 2.5v7m0 0 2.5-2.5M8 9.5 5.5 7" stroke="currentColor" stroke-width="1.5" />
								<path d="M3.5 10.5v2h9v-2" stroke="currentColor" stroke-width="1.5" />
							</svg>
							Download PDF
						</a>
						<a
							href={edition.sourceRepositoryUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex h-9 items-center gap-2 border border-primary/60 px-3 text-primary transition-colors hover:border-primary hover:bg-primary/10 hover:text-loud-foreground focus:outline-none focus:ring-2 focus:ring-primary/60"
						>
							<svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none">
								<path d="m6 4-4 4 4 4M10 4l4 4-4 4M9 2.5 7 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							View source
						</a>
					</div>
				</div>

				<div class="max-w-4xl mx-auto">
					<ArticleContent>
						<slot />
					</ArticleContent>
				</div>

				{(previous || next) && (
					<nav
						aria-label="Whitepaper section navigation"
					class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-y border-primary/20 px-4 mt-12 py-5 font-display uppercase tracking-wider"
					>
						{previous ? (
							<a href={previous.href} class="group text-left hover:text-primary transition-colors">
								<span class="block text-xs tracking-[0.2em] text-muted-foreground mb-2">← Previous</span>
								<span class="text-sm">{previous.title}</span>
							</a>
						) : <span />}
						{next && (
							<a href={next.href} class="group text-right hover:text-primary transition-colors">
								<span class="block text-xs tracking-[0.2em] text-muted-foreground mb-2">Next →</span>
								<span class="text-sm">{next.title}</span>
							</a>
						)}
					</nav>
				)}
			</div>
		</main>

		<Footer />
	</div>
</Layout>
